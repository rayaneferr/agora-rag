# Modèle au format LiteLLM : provider/modele
LLM_MODEL=anthropic/claude-sonnet-5
# Soit la variable standard du provider (ANTHROPIC_API_KEY, OPENAI_API_KEY, ...), soit LLM_API_KEY.
# Si rien n'est défini, la clé est demandée au lancement.
# ANTHROPIC_API_KEY=

QDRANT_URL=http://localhost:6333
EMBED_MODEL=BAAI/bge-m3
