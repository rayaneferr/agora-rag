# Aucune clé API : les serveurs MCP ne font que de la recherche, c'est le client (Claude…) qui raisonne.
EMBED_MODEL=BAAI/bge-m3
# AGORA_HOME=~/agora-data # où ranger l'index et les fichiers sources (défaut : ./data)

# Révisions (commits Hugging Face) acceptées pour l'index et le modèle d'embeddings. Les valeurs par défaut sont
# dans le code (index_hub.py, vectorstore.py) ; ne les changer que pour tester une nouvelle publication.
# AGORA_INDEX_REVISION=fc60445f270a8617ce109eaef423a4873ed0fb2a
# EMBED_REVISION=5617a9f61b028005a4858fdac845db406aefb181

# Serveur MCP en HTTP (uv run agora-mcp-public) : tous les contextes sur un seul port, /<contexte>/mcp.
# PORT=8100
# MCP_ALLOWED_HOSTS=mcp.example.org   # hôtes acceptés en plus de la boucle locale (DNS rebinding)
# MCP_ALLOWED_ORIGINS=                # défaut : https://<chaque hôte autorisé>
# MCP_RATE_LIMIT=60                   # requêtes par minute et par IP (0 : pas de limite)
# MCP_FORWARDED_HOPS=0                # proxys de confiance devant le service (lecture de X-Forwarded-For)
